# Copy to `.env` (or `.dev.vars`) for LOCAL development only. Never commit the real file.
# In production, set these in the Cloudflare dashboard: Workers & Pages -> your worker ->
# Settings -> Variables and Secrets (use type "Secret" for keys), or `npx wrangler secret put NAME`.

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# Google sign-in, for everyone (Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID, type "Web application"). Redirect URI: https://<your-app>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub sign-in, for administrators only (https://github.com/settings/developers -> OAuth Apps).
# Callback: https://<your-app>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Administrators (comma-separated). Admins get the admin panel and no daily limit.
# Matched against the verified Google email, and against the GitHub username.
ADMIN_EMAILS=you@example.com
ADMIN_GITHUB_USERS=your-github-username
# (Older setups used ALLOWED_GITHUB_USERS; it still works as ADMIN_GITHUB_USERS when that is not set.)
# Messages per user per day (default 30). Can also be changed in the admin panel.
# DEFAULT_DAILY_LIMIT=30

# ---------------------------------------------------------------------------
# Free AI providers: set at least one. All have no-card free tiers.
# ---------------------------------------------------------------------------
# https://console.groq.com/keys          (stay on the Free plan, no card)
GROQ_API_KEY=
# https://aistudio.google.com/apikey     (use a project WITHOUT billing enabled)
GEMINI_API_KEY=
# https://openrouter.ai/settings/keys    (the app only ever calls ":free" models)
OPENROUTER_API_KEY=
# https://console.mistral.ai/api-keys    (free "Experiment" plan)
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# APP_NAME=Assistant
# PROVIDER_ORDER=groq,gemini,openrouter,mistral,workers-ai
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=            (empty = pick the best ":free" model automatically)
# MISTRAL_MODEL=mistral-small-latest
# WORKERS_AI_ENABLED=true
# WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
# WORKERS_AI_MODELS=           (comma-separated list to override the built-in catalogue)
# MAX_CONTEXT_CHARS=16000      (history sent per request; keep low for Groq's 8K tokens/min)
# MAX_OUTPUT_TOKENS=2048
# CHAT_RATE_LIMIT_PER_MINUTE=20
# SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Local development only. NEVER set these in production.
# ---------------------------------------------------------------------------
# Enables a username-only login form, and only for requests to localhost.
# DEV_LOGIN=true
# `npm run dev` runs with remote bindings off, so Workers AI is unavailable locally:
# WORKERS_AI_ENABLED=false
# Point providers at the offline mock server (`npm run mock:llm`) to develop without any keys:
# GROQ_API_KEY=mock
# GROQ_BASE_URL=http://127.0.0.1:8790/groq
# GEMINI_API_KEY=mock
# GEMINI_BASE_URL=http://127.0.0.1:8790/gemini
